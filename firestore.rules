rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User isolated data partition (works with authenticated users and phone-bound registered devices)
    match /users/{userId}/{document=**} {
      allow read, write: if true;
    }

    // Phone-based account registry for multi-device login, device recognition, and restore
    match /phone_accounts/{phoneId} {
      allow read, write: if true;
    }

    // Support tickets
    match /tickets/{ticketId} {
      allow create: if true;
      allow read, update: if true;
      allow delete: if request.auth != null && request.auth.token.email == "mnazih298@gmail.com";
    }

    // Commercial & Global App Config
    match /app_config/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
