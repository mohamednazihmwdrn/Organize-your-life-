rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User isolated private data partition
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Support tickets
    match /tickets/{ticketId} {
      allow create: if true;
      allow read, update: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.email == "mnazih298@gmail.com");
      allow delete: if request.auth != null && request.auth.token.email == "mnazih298@gmail.com";
    }

    // Commercial & Global App Config
    match /app_config/{configId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
